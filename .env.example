# PumpPal Environment Configuration

# Application Environment
NODE_ENV=development
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=https://api.pumppal.io
VITE_API_VERSION=v1

# Blockchain Configuration
VITE_NETWORK=testnet
VITE_BASE_RPC_URL=https://sepolia.base.org
VITE_BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Contract Addresses (Base Sepolia Testnet)
VITE_ICO_CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b8D4C9db96C4b5Da5f
VITE_USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Contract Addresses (Base Mainnet)
VITE_ICO_CONTRACT_ADDRESS_MAINNET=0x742d35Cc6634C0532925a3b8D4C9db96C4b5Da5f
VITE_USDC_CONTRACT_ADDRESS_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Wallet Configuration
VITE_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id
VITE_ENABLE_WALLET_CONNECT=true

# Third-party Services
VITE_ALCHEMY_API_KEY=your_alchemy_api_key
VITE_QUICKNODE_ENDPOINT=your_quicknode_endpoint

# Analytics & Monitoring
VITE_SENTRY_DSN=your_sentry_dsn
VITE_GOOGLE_ANALYTICS_ID=your_ga_id
VITE_MIXPANEL_TOKEN=your_mixpanel_token

# Feature Flags
VITE_ENABLE_STAKING=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DEBUG_MODE=false

# Payment Configuration
VITE_PAYMENT_GATEWAY_URL=https://payments.vistara.dev
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# IPFS Configuration
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ALLOWED_ORIGINS=http://localhost:3000,https://pumppal.io

# Development Configuration
VITE_MOCK_API=false
VITE_ENABLE_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# Social Media & Marketing
VITE_TWITTER_HANDLE=@PumpPalICO
VITE_DISCORD_INVITE=https://discord.gg/pumppal
VITE_TELEGRAM_CHANNEL=https://t.me/pumppal

# Support Configuration
VITE_SUPPORT_EMAIL=support@pumppal.io
VITE_DOCS_URL=https://docs.pumppal.io
VITE_STATUS_PAGE_URL=https://status.pumppal.io
